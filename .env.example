# Sentinel — Configuration
# Copy this file to .env and customize

# Directory containing projects to scan (absolute path on host)
PROJECTS_DIR=/home/user/projects

# Directories to exclude from scan (comma-separated, empty by default)
# Sentinel's own IOC/i18n data files are automatically filtered
EXCLUDE_DIRS=

# Maximum search depth in directory tree
SCAN_DEPTH=4

# Minimum severity threshold: low, medium, high, critical
SEVERITY_MIN=medium

# Report format: md or json
REPORT_FORMAT=md

# Report language: en (default) or fr
REPORT_LANG=en

# Auto-update IOCs from threat intelligence feeds during 'update' command
# Set to 'false' to disable (air-gapped environments)
IOC_AUTO_UPDATE=true

# === Secrets scanning (TruffleHog) ===
# Skip secrets scanning entirely (useful for supply-chain-only CI)
SKIP_SECRETS=false

# Scan mode: "verified" (default, only active secrets) or "full" (all potential secrets)
SECRETS_MODE=verified

# Limit git history depth for secrets scan (empty = unlimited)
# SECRETS_MAX_DEPTH=50

# Scan git history only since this commit (empty = full history)
# SECRETS_SINCE_COMMIT=

# Timeout in seconds for secrets scan (default: 300 = 5 minutes)
SECRETS_TIMEOUT=300

# UID/GID for report file permissions
# Use $(id -u) and $(id -g) to match your host user
UID=1000
GID=1000
