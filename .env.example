# Sentinel — Configuration
# Copier ce fichier en .env et adapter les valeurs

# Repertoire des projets a scanner (chemin absolu sur l'hote)
PROJECTS_DIR=/home/user/projects

# Repertoires a exclure du scan (separes par des virgules)
# Par defaut "sentinel" est exclu pour eviter les faux positifs
EXCLUDE_DIRS=sentinel

# Profondeur max de recherche dans l'arborescence
SCAN_DEPTH=4

# Seuil minimum de severite : low, medium, high, critical
SEVERITY_MIN=medium

# Format du rapport : md ou json
REPORT_FORMAT=md

# UID/GID pour les permissions des rapports generes
# Utiliser $(id -u) et $(id -g) pour correspondre a votre utilisateur
UID=1000
GID=1000
