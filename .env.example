# Sentinel — Configuration
# Copy this file to .env and customize

# Directory containing projects to scan (absolute path on host)
PROJECTS_DIR=/home/user/projects

# Directories to exclude from scan (comma-separated)
# "sentinel" is excluded by default to avoid false positives
EXCLUDE_DIRS=sentinel

# Maximum search depth in directory tree
SCAN_DEPTH=4

# Minimum severity threshold: low, medium, high, critical
SEVERITY_MIN=medium

# Report format: md or json
REPORT_FORMAT=md

# Report language: en (default) or fr
REPORT_LANG=en

# UID/GID for report file permissions
# Use $(id -u) and $(id -g) to match your host user
UID=1000
GID=1000
